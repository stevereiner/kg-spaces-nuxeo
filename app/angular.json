{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "kg-spaces-nuxeo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "kgs",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/kg-spaces-nuxeo",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": ["src/favicon.ico", "src/assets"],
            "styles": ["src/styles.scss", "node_modules/@flexible-graphrag/angular-ui/styles/fg-theme.scss"],
            "allowedCommonJsDependencies": [
              "cytoscape", "cytoscape-fcose", "cytoscape-dagre", "cose-base", "layout-base",
              "@dagrejs/dagre", "@dagrejs/graphlib"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "2mb", "maximumError": "4mb" },
                { "type": "anyComponentStyle", "maximumWarning": "8kb", "maximumError": "16kb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": { "port": 4300, "proxyConfig": "proxy.conf.json", "servePath": "/kg-spaces-nuxeo/" },
          "configurations": {
            "production": { "buildTarget": "kg-spaces-nuxeo:build:production" },
            "development": { "buildTarget": "kg-spaces-nuxeo:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
